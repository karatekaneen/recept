@smör{110%g}, @socker{100%g}, @sirap{20%g}, @mjöl{150%g}, @vaniljsocker{1%msk}, @bakpulver{1%tsk}

=
@lagerblad{8%st}, @kryddpeppar{1%msk}, @svartpeppar{1%tsk}, @ingefära{1%tsk}

